<patch-1.0 appVersion="1.0.12">
   <comment type="patch/comment" x="112" y="28" text="=== 8-VOICE KORG MS-20: ONE EG1 + ONE EG2 | ARP OFF = MS-20 POLY (VCO1+VCO2 PER VOICE) | ARP = VCO1 ORGAN GATE | LATCH = VCO1 CHORD HELD | v11: saw PW = 12-stage phaser, stereo spread BBD, ESP A/B layers | v31: 3.4 s power-on LED show, single-tap delay, tap tempo on the momentary switch, filter silent without notes, mono mode (patch KBD CV -> VCO1+2 CV IN), VCO2 pitch +-5, vibrato 4.6 Hz, ESP arp off = delay send, switch = tone; attack stops on key up, runaway feedback, ESP knobs follow the arp mode (no pickup), VCO1 32'-4', cleaner gain staging, latch chord replace, knob glide, iC LEDs, confirmed patch bay ==="/>
   <comment type="patch/comment" x="1092" y="84" text="PATCH BAY: 0 normal 1 MG tri 2 MG sq 3 EG1 4 EG1rev 5 EG2 6 EG2rev 7 S&amp;H 8 noise 9 wheel 10 button 11 kbdCV 12 kbdTrig 13 open"/>
   <patchobj type="patch/object" uuid="b100000000000000000000000000000000000500" name="MS20_Voices" x="112" y="98">
      <params>
         <int32.hradio name="vco1wave" value="1"/>
         <int32.hradio name="vco1oct" value="1"/>
         <frac32.u.map name="pw" MidiCC="14" value="0.0"/>
         <frac32.u.map name="portamento" MidiCC="5" value="0.5"/>
         <bool32.tgl name="multitrig" value="0"/>
         <int32.hradio name="vco2wave" value="1"/>
         <int32.hradio name="vco2oct" value="1"/>
         <frac32.s.map name="vco2fine" value="0.0"/>
