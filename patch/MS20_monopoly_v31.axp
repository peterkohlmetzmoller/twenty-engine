float ao1=0.f;
if(am>0&&mono_on){
 uint32_t f1a;MTOFEXTENDED(__SSAT((int32_t)((ap-64.f)*2097152.f)+oct1+inlet_pmodarp+(int32_t)drf2+vib,28),f1a);
 float d1=f1a*2.3283e-10f;if(d1>0.48f)d1=0.48f;p1a+=d1;if(p1a>=1.f)p1a-=1.f;
 if(w1==0){float sw=bh(p1a);float tw=(p1a<0.5f)?(p1a*4.f-1.f):(3.f-p1a*4.f);ao1=sw+pws*(tw-sw);}
 else if(w1==1)ao1=(2.f*p1a-1.f)-pblp(p1a,d1);
 else if(w1==2){if(dty>0.001f){float r=(p1a<dty)?1.f:-1.f;r+=pblp(p1a,d1);float ps=p1a-dty;if(ps<0.f)ps+=1.f;r-=pblp(ps,d1);ao1=(r-(2.f*dty-1.f))*0.85f;}}
 else ao1=ns;
}
