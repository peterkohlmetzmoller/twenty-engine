         <includes/>
         <code.declaration><![CDATA[
int16_t *bbd; uint32_t w_i; float s_t, l_s1, l_s2, h_s1; uint32_t w_ph, f_ph, wf_rng; float d_t, d_s, d_t2, d_s2, m_sL, m_sR, mw, d_e, syb, lim;
inline float b_sat(float v) { if(v>1.5f) return 1.f; if(v<-1.5f) return -1.f; return v-(0.148f*v*v*v); }
inline float f_sin(uint32_t ph) { float x=(int32_t)ph*4.65e-10f; return 4.f*x*(1.f-(x<0.f?-x:x)); }
// read d samples back, linear interpolation (same result as the earlier float version, integer index = cheaper)
inline float r_bbd(float d) {
   if(d<8.f) d=8.f; if(d>131050.f) d=131050.f;
   int32_t di=(int32_t)d; float fr=d-(float)di;
   uint32_t j=(w_i-(uint32_t)di)&131071U; uint32_t jm=(j-1U)&131071U;
   float a=(float)bbd[j]; float b=(float)bbd[jm];
   return (a+fr*(b-a))*3.05e-5f;
}
         
/* ---- knob feel: every move glides (~15 ms); some knobs land a hair off (+-half a knob step), fixed until the next move ---- */
float kn_s[7];int32_t kn_l[7],kn_o[7];uint32_t kn_r;int kn_f;
inline int32_t kn_upd(int i,int32_t p,int32_t lo,int32_t hi,int32_t half){
 if(p!=kn_l[i]){kn_l[i]=p;if(half){kn_r=kn_r*1664525U+1013904223U;kn_o[i]=(int32_t)(((int64_t)(int32_t)kn_r*half)>>31);}} /* knob moved: new tiny offset */
 int32_t tg=p+kn_o[i];if(tg<lo)tg=lo;if(tg>hi)tg=hi;
 if(kn_f)kn_s[i]=(float)tg;else kn_s[i]+=((float)tg-kn_s[i])*0.055f;    /* first tick: no glide from zero */
 return (int32_t)kn_s[i];
}
]]></code.declaration>
         <code.init><![CDATA[
static int16_t _b[131072] __attribute__((section(".sdram"))); bbd = &_b[0];
for(int i=0; i<131072; i++) bbd[i]=0; w_i=0; s_t=28000.f; l_s1=l_s2=h_s1=0.f; w_ph=f_ph=0; wf_rng=22446688U; d_t=d_s=d_t2=d_s2=m_sL=m_sR=mw=d_e=syb=lim=0.f;
         
for(int i=0;i<7;i++){kn_s[i]=0.f;kn_l[i]=0x7FFFFFFF;kn_o[i]=0;}kn_r=2654417092U;kn_f=1;
]]></code.init>
         <code.krate><![CDATA[
int32_t kn_time=kn_upd(0,param_time,0,134217727,0); /* delay time lands exactly (tap tempo must stay in time) */
int32_t kn_feedback=kn_upd(1,param_feedback,0,134217727,524288);
int32_t kn_bbdfilter=kn_upd(2,param_bbdfilter,0,134217727,524288);
int32_t kn_wowflutter=kn_upd(3,param_wowflutter,0,134217727,524288);
int32_t kn_drywet=kn_upd(4,param_drywet,0,134217727,524288);
int32_t kn_spread=kn_upd(5,param_spread,0,134217727,524288);
int32_t kn_width=kn_upd(6,param_width,0,134217727,524288);
kn_f=0;

float tn=kn_time*7.45e-9f; float tt=1400.f+(0.45f*tn+0.55f*tn*tn)*126000.f;
// arp on: time locked to the arp (dotted 8th), halved until it fits the BBD memory; arp off: the time knob as before
float syt=(float)inlet_synctime;bool syn=(syt>0.f);
if(syn){while(syt>120000.f)syt*=0.5f;if(syt<480.f)syt=480.f;tt=syt;}
syb+=((syn?1.f:0.f)-syb)*0.02f;          // crossfade golden-ratio cloud <-> rhythmic repeats (~17 ms)
float fk=kn_feedback*7.45e-9f;float rf=(fk-0.75f)*4.f;if(rf<0.f)rf=0.f;if(rf>1.f)rf=1.f; /* top quarter of the feedback knob: runaway */
float fg=fk*0.95f+rf*0.8f;                 /* past about 90 %: the repeats build up and self-oscillate, held by the BBD saturation */ float glb=0.06f+(kn_bbdfilter*7.45e-9f)*0.38f;float trk=sqrtf(14000.f/s_t);if(trk>1.6f)trk=1.6f;if(trk<0.35f)trk=0.35f;float gl=glb*trk;if(gl>0.9f)gl=0.9f; // tone tracks delay time
float mx=kn_drywet*7.45e-9f; float mc=mx*mx; float dg=1.0f-mc*mx; float bw=mc*0.62f;
float sg=bw;
w_ph+=930000U; f_ph+=6800000U; wf_rng=wf_rng*196314165U+907633515U;
if((wf_rng&0x7F)==0) d_t=(int32_t)wf_rng*4.65e-10f; d_s+=0.004f*(d_t-d_s);
if((wf_rng&0x7F)==64) d_t2=(int32_t)(wf_rng*2654435761U)*4.65e-10f; d_s2+=0.004f*(d_t2-d_s2);  // right side: its own random drift
float wa=(kn_wowflutter*7.45e-9f)+mw; if(wa>1.25f) wa=1.25f;
float msc=wa*wa*(s_t*0.0065f+18.f);
float wL=0.72f*f_sin(w_ph)+0.28f*d_s; float fL=f_sin(f_ph)*0.045f; float tmo=(wL+fL)*msc;
float wR=0.72f*f_sin(w_ph+0x40000000U)+0.28f*d_s2; float fR=f_sin(f_ph+0x55555555U)*0.045f; float tmoR=(wR+fR)*msc; // right wow/flutter a quarter cycle apart: the two "BBD chips" drift against each other
float spr=kn_spread*7.45e-9f*960.f;   // 0..960 samples = 0..20 ms: left later, right earlier
float wid=kn_width*7.45e-9f*2.f;      // 0..200 % (32 = 100 %)
         ]]></code.krate>
         <code.srate><![CDATA[
s_t+=0.0003f*(tt-s_t); m_sL+=0.001f*(tmo-m_sL); m_sR+=0.001f*(tmoR-m_sR);
float mL=s_t+m_sL; float mR=s_t+m_sR; float dry=inlet_in*7.45e-9f;
float l4=r_bbd(mL+spr);                    /* one tap per side: every repeat lands on the delay time (tap tempo) */
float r4=r_bbd(mR-spr);
float mt=(l4+r4)*0.5f+(l4-r4)*0.5f*rf;     /* runaway: one side only (the two sides wobble apart and would partly cancel) */
float fs=mt*fg;                             /* feedback from the single tap */ float bi=dry*sg+fs; h_s1+=0.008f*(bi-h_s1); bi-=h_s1;  // one shared BBD line, fed from both sides
l_s1+=gl*(bi-l_s1); l_s2+=gl*(l_s1-l_s2); float sb=b_sat(l_s2); if(sb>0.99f)sb=0.99f; if(sb<-0.99f)sb=-0.99f;
bbd[w_i]=(int16_t)(sb*32767.f); w_i=(w_i+1U)&131071U;
float eL=l4*0.65f; float eR=r4*0.65f;      /* stereo from spread and the two sides' independent wow/flutter */
float eM=0.5f*(eL+eR); float eS=0.5f*(eL-eR)*wid;   // width on the echoes only
float base=dry*dg;                                    // dry stays mono in the centre
float oL=base+eM+eS,oR=base+eM-eS;
// output limiter: only acts on peaks above -1 dBFS (instant attack, ~100 ms release, stereo-linked)
float pkL=__builtin_fabsf(oL),pkR=__builtin_fabsf(oR);if(pkR>pkL)pkL=pkR;
lim*=0.99979f;if(pkL>lim)lim=pkL;
if(lim>0.891f){float lg=0.891f/lim;oL*=lg;oR*=lg;}
outlet_outL=(int32_t)(oL*134217728.f);
outlet_outR=(int32_t)(oR*134217728.f);
         ]]></code.srate>
      </object>
   </patchobj>
