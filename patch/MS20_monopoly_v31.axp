         <frac32.u.map name="arpmode" MidiCC="11" value="0.0"/>
         <frac32.u.map name="arprate" value="41.5"/>
         <int32.hradio name="arpoct" value="3"/>
         <int32.hradio name="arporder" value="2"/>
