   <comment type="patch/comment" x="1092" y="532" text="ESP KNOBS  A: arp rate / arp oct / arp order / delay send   B (vel 125+ or switch held): time / feedback / wow / tone"/>
   <patchobj type="patch/object" uuid="b100000000000000000000000000000000000700" name="ESP_Layer" x="1092" y="560">
      <params/>
      <attribs/>
      <object id="patch/object" uuid="b100000000000000000000000000000000000700">
         <sDescription>MS-20 iC ESP knobs CC88-91. Arp off: delay time, feedback, wow/flutter, delay send (hold the momentary switch or a key struck at velocity 125-127: CC91 = tone). Arp on: arp rate, arp octaves, arp order, delay send (hold the switch / hard key: delay time, feedback, wow/flutter, tone). A knob sets its value as soon as it moves. Tap the momentary switch for tap tempo: arp off = delay time (tap interval = repeat time), arp on = arp tempo (taps = quarter notes). Turning the time / rate knob afterwards overrides it.</sDescription>
         <inlets>
            <int32 name="mode"/>
         </inlets>
         <outlets>
            <bool32 name="layerb"/>
         </outlets>
         <displays/>
         <params/>
         <attribs/>
         <includes/>
         <code.declaration><![CDATA[
static const int NK=4;           // CC88..91
static const int NSET=3;         // 0 = arp controls, 1 = delay, 2 = delay with send on CC91
int nhard;uint8_t hard[16];bool btn;volatile int amode;
/* tap tempo on the momentary switch: a short press (< 350 ms, no ESP knob turned meanwhile) is a tap */
volatile uint32_t etick;uint32_t tpress,tlast;bool knobbed;int ntap;float tiv[3];
float arpN(float hz){float lo=0.f,hi=1.f;for(int i=0;i<24;i++){float n=0.5f*(lo+hi);float n2=n*n;float h=0.5f+n2*20.f+(n2*n2*n)*150.f;if(h<hz)lo=n;else hi=n;}return 0.5f*(lo+hi);} /* inverse of the arp rate curve */
void tap(uint32_t now){
 uint32_t d=now-tlast;tlast=now;
 if(d>9000||d<60){ntap=0;return;}             /* gap over 3 s: start again */
 tiv[ntap%3]=(float)d;ntap++;
 int c=(ntap<3)?ntap:3;float iv=0.f;for(int i=0;i<c;i++)iv+=tiv[i];iv/=(float)c;   /* average of the last 3 intervals (control ticks, 3000/s) */
 float sec=iv/3000.f;
 if(amode!=0){                                /* arp: taps are quarter notes, arp steps are 16ths */
  float hz=4.f/sec;if(hz<0.5f)hz=0.5f;if(hz>170.f)hz=170.f;
  PExParameterChange(&parent->PExch[PARAM_INDEX_MS20__Voices_arprate],(int32_t)(arpN(hz)*134217728.f),0xFFFD);
 }else{                                       /* poly / mono: tap interval = delay time */
  float x=(sec*48000.f-1400.f)/126000.f;if(x<0.f)x=0.f;if(x>1.f)x=1.f;
  float tn=(-0.45f+sqrtf(0.2025f+2.2f*x))/1.1f;if(tn<0.f)tn=0.f;if(tn>1.f)tn=1.f;   /* inverse of the delay time curve */
  PExParameterChange(&parent->PExch[PARAM_INDEX_BBD__Delay_time],(int32_t)(tn*134217727.f),0xFFFD);
 }
}
int pidx[NSET][NK];int zoned[NSET][NK]; // zoned: 4-step selector (arp octaves / order), else a 0..64 knob
int curset(){bool held=(nhard>0||btn);if(amode!=0)return held?1:0;return held?1:2;} /* arp on: arp, held = delay + tone; arp off: delay + send, held = delay + tone */
void knob(int k,int cc){
 int l=curset();
 if(zoned[l][k])PExParameterChange(&parent->PExch[pidx[l][k]],cc>>5,0xFFFD);                                   // 4 zones
 else PExParameterChange(&parent->PExch[pidx[l][k]],(cc!=127)?(cc<<20):0x07FFFFFF,0xFFFD);                       // same scaling as Ksoloti's built-in CC assignment
}
         ]]></code.declaration>
         <code.init><![CDATA[
nhard=0;btn=false;amode=0;etick=0;tpress=tlast=0;knobbed=false;ntap=0;for(int i=0;i<3;i++)tiv[i]=0.f;
for(int l=0;l<NSET;l++)for(int k=0;k<NK;k++)zoned[l][k]=0;
// Index names spelled out (works on every Ksoloti version). If an object is renamed, update its name here (underscores doubled).
// set 0 (arp on): CC88 arp rate, CC89 arp octaves, CC90 arp order, CC91 delay send
pidx[0][0]=PARAM_INDEX_MS20__Voices_arprate;
pidx[0][1]=PARAM_INDEX_MS20__Voices_arpoct;zoned[0][1]=1;
pidx[0][2]=PARAM_INDEX_MS20__Voices_arporder;zoned[0][2]=1;
pidx[0][3]=PARAM_INDEX_BBD__Delay_drywet;
// set 1 (switch held, both modes): CC88 delay time, CC89 feedback, CC90 wow/flutter, CC91 tone
pidx[1][0]=PARAM_INDEX_BBD__Delay_time;
pidx[1][1]=PARAM_INDEX_BBD__Delay_feedback;
pidx[1][2]=PARAM_INDEX_BBD__Delay_wowflutter;
pidx[1][3]=PARAM_INDEX_BBD__Delay_bbdfilter;
// set 2 (arp off, normal): as set 1, but CC91 = delay send
pidx[2][0]=PARAM_INDEX_BBD__Delay_time;
pidx[2][1]=PARAM_INDEX_BBD__Delay_feedback;
pidx[2][2]=PARAM_INDEX_BBD__Delay_wowflutter;
pidx[2][3]=PARAM_INDEX_BBD__Delay_drywet;
         ]]></code.init>
         <code.krate><![CDATA[
amode=inlet_mode;                 /* the MIDI handler can't read inlets: keep the arp mode here */
etick++;                          /* control-tick clock for tap tempo */
outlet_layerb=(curset()!=0)?1:0;  /* LED display: knobs are on delay controls */
         ]]></code.krate>
         <code.midihandler><![CDATA[
uint8_t st=status&0xF0;
if(st==MIDI_NOTE_ON&&data2>0){
 if(data2>124){bool f=false;for(int i=0;i<nhard;i++)if(hard[i]==data1)f=true;if(!f&&nhard<16)hard[nhard++]=data1;} // hard hit: note still plays, and switches the knobs while held
}else if(st==MIDI_NOTE_OFF||(st==MIDI_NOTE_ON&&data2==0)){
 for(int i=0;i<nhard;i++){if(hard[i]==data1){for(int j=i;j<nhard-1;j++)hard[j]=hard[j+1];nhard--;break;}}
}else if(st==0xD0){
 bool nb=(data1>0);               // momentary switch (channel pressure): held = knob layer, short press = tap tempo
 uint32_t now=etick;
 if(nb&&!btn){tpress=now;knobbed=false;}
 else if(!nb&&btn){if(!knobbed&&(now-tpress)<1050)tap(tpress);}
 btn=nb;
}else if(st==MIDI_CONTROL_CHANGE&&data1>=88&&data1<=91){
 knob(data1-88,data2);if(btn)knobbed=true;   /* knob turned while the switch is held: that press was a layer hold, not a tap */
}
         ]]></code.midihandler>
      </object>
   </patchobj>
