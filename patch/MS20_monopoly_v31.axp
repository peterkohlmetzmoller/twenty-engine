   <patchobj type="patch/object" uuid="b100000000000000000000000000000000000600" name="PatchBay" x="1092" y="98">
      <params>
         <int32 name="total" value="0"/>
         <int32 name="freq" value="0"/>
         <int32 name="vco2freq" value="0"/>
         <int32 name="hpf" value="0"/>
         <int32 name="lpf" value="0"/>
         <int32 name="vca" value="0"/>
         <int32 name="eg1trig" value="0"/>
         <int32 name="eg2trig" value="0"/>
         <int32 name="shin" value="0"/>
         <int32 name="shclock" value="0"/>
      </params>
      <attribs/>
      <object id="patch/object" uuid="b100000000000000000000000000000000000600">
         <sDescription>MS-20 iC patch bay. Each input shows its source: 0 normal, 1 MG tri, 2 MG square, 3 EG1, 4 EG1 rev, 5 EG2, 6 EG2 rev, 7 S&amp;H, 8 noise, 9 wheel, 10 button, 11 kbd CV, 12 kbd trig, 13 open (plug in, nothing connected). Cables from the iC set these; editing them by hand overrides until the next cable event.</sDescription>
         <inlets>
            <frac32.bipolar name="mgtri"/>
            <frac32.bipolar name="mgsq"/>
            <frac32.positive name="eg1"/>
            <frac32.positive name="eg2"/>
            <frac32.positive name="wheel"/>
            <bool32 name="button"/>
            <frac32.bipolar name="kbdcv"/>
            <bool32 name="kbdtrig"/>
         </inlets>
         <outlets>
            <frac32.bipolar name="total"/>
            <frac32.bipolar name="freq"/>
            <frac32.bipolar name="vco2freq"/>
            <frac32.bipolar name="hpf"/>
            <frac32.bipolar name="lpf"/>
            <frac32.bipolar name="vca"/>
            <frac32.bipolar name="eg1trig"/>
            <frac32.bipolar name="eg2trig"/>
            <int32 name="evtype"/>
            <int32 name="evjacka"/>
            <int32 name="evjackb"/>
            <int32 name="mono"/>
            <int32 name="power"/>
            <int32 name="poweron"/>
         </outlets>
         <displays/>
         <params>
            <int32 name="total" description="TOTAL in (replaces MG on the three MG/T.EXT knobs)">
               <MinValue i="0"/>
               <MaxValue i="13"/>
            </int32>
            <int32 name="freq" description="VCO FREQ in (replaces EG1 on the EG1/EXT knob)">
               <MinValue i="0"/>
               <MaxValue i="13"/>
            </int32>
            <int32 name="vco2freq" description="VCO2 FREQ in (1 V/oct style, added to VCO2 pitch)">
               <MinValue i="0"/>
               <MaxValue i="13"/>
            </int32>
            <int32 name="hpf" description="HPF CUTOFF in (replaces EG2 on the HPF EG2/EXT knob)">
               <MinValue i="0"/>
               <MaxValue i="13"/>
            </int32>
            <int32 name="lpf" description="LPF CUTOFF in (replaces EG2 on the LPF EG2/EXT knob)">
               <MinValue i="0"/>
               <MaxValue i="13"/>
            </int32>
            <int32 name="vca" description="VCA CONTROL in (gain 0..1 on the output; unpatched = full)">
               <MinValue i="0"/>
               <MaxValue i="13"/>
            </int32>
            <int32 name="eg1trig" description="EG1 TRIG in (replaces the keyboard gate for EG1)">
               <MinValue i="0"/>
               <MaxValue i="13"/>
            </int32>
            <int32 name="eg2trig" description="EG2 TRIG in (replaces the keyboard gate for the shared EG2)">
               <MinValue i="0"/>
               <MaxValue i="13"/>
            </int32>
            <int32 name="shin" description="S&amp;H in (normal: noise)">
               <MinValue i="0"/>
               <MaxValue i="13"/>
            </int32>
            <int32 name="shclock" description="S&amp;H clock in (normal: MG square)">
               <MinValue i="0"/>
               <MaxValue i="13"/>
            </int32>
         </params>
         <attribs/>
         <includes/>
         <code.declaration><![CDATA[
// ---- MS-20 iC patch bay ----
// Outputs carry NORMAL when an input is unpatched, so the receiving module keeps its own MS-20 normal source.
static const int32_t NORMAL=(int32_t)0x80000000;
static const int NDEST=10;   // order = params: total freq vco2freq hpf lpf vca eg1trig eg2trig shin shclock
static const int OPEN=13;    // plug in the input, other end not connected: normal broken, no signal
int8_t jack[35];int8_t lk[35];int monof;int pwr,pon; /* volume knob power switch: state, and a counter that steps on every switch-on */ /* monof: KBD CV OUT patched into VCO1+2 CV IN */ /* lk: jack is part of a cable connection */             // NRPN jack number -> >0 source id (output jack), <0 -(destination+1) (input jack), 0 unknown
int pidx[NDEST];
int32_t src[14];
int m99,m98,m6;bool h99,h98,h6;int ev99,ev98,ev6;
uint32_t nrng;int32_t shval;int pclk;
void setsel(int d,int v){if(d>=0&&d<NDEST)PExParameterChange(&parent->PExch[pidx[d]],v,0xFFFD);} // same call as Ksoloti's own CC assignment -> selector moves in the editor
void patchEvent(int t,int a,int b){
 if(t==6){int on=(a!=b)?1:0;if(on&&!pwr)pon++;pwr=on;return;}   /* 6 = volume knob power switch: 6/0/127 on, 6/0/0 off */
 if(t!=4&&t!=5)return;                 // 4 = connect / plug in, 5 = disconnect / plug out
 if(a<0||a>34||b<0||b>34)return;
 if((a==31&&b==25)||(a==25&&b==31))monof=(t==4)?1:0;          /* KBD CV -> VCO1+2 CV IN: mono mode */
 if(t==5&&a==b&&(a==25||a==31))monof=0;                       /* either plug pulled (or the power-on dump): poly */
 if(a==b){                             /* single plug in / out */
  int d=jack[a];
  if(t==5)lk[a]=0;
  if(d<0){if(t==5)setsel(-d-1,0);else if(!lk[a])setsel(-d-1,OPEN);} /* plug-out restores the normal; plug-in breaks it, unless that jack is already connected (the iC sends connect before plug-in) */
  return;
 }
 if(t==4){lk[a]=1;lk[b]=1;}else{lk[a]=0;lk[b]=0;}
 int ja=jack[a],jb=jack[b];
 int in=(ja<0)?ja:((jb<0)?jb:0);int out=(ja>0)?ja:((jb>0)?jb:0);
 if(!in)return;                        // two outputs, or a jack not in the table yet
 if(t==4){if(out>0)setsel(-in-1,out);}
 else setsel(-in-1,OPEN);              // cable pulled; the plug-out event that follows restores the normal
}
         ]]></code.declaration>
         <code.init><![CDATA[
for(int i=0;i<35;i++){jack[i]=0;lk[i]=0;}monof=0;pwr=1;pon=0;
// ---- jack table: confirmed on the MS-20 iC (one cable from TOTAL through every jack) ----
// outputs
jack[1]=1;    // MG triangle out
jack[6]=2;    // MG square out
jack[10]=3;   // EG1 out
jack[11]=4;   // EG1 REV out
jack[22]=6;   // EG2 REV out
jack[7]=7;    // S&H out
jack[19]=8;   // pink noise out (noise)
jack[23]=8;   // white noise out (noise)
jack[27]=9;   // mod wheel out
jack[33]=10;  // momentary button out
jack[31]=11;  // KBD CV out
jack[32]=12;  // KBD TRIG out
// inputs
jack[0]=-1;   // TOTAL in
jack[5]=-2;   // VCO FREQ in (EG1/EXT)
jack[24]=-3;  // VCO2 CV in
jack[13]=-4;  // HPF CUTOFF in
jack[17]=-5;  // LPF CUTOFF in
jack[14]=-6;  // VCA CONTROL in
jack[18]=-7;  // EG1 TRIG in
jack[26]=-8;  // KBD TRIG in (EG2 trigger)
jack[2]=-9;   // S&H in
jack[4]=-10;  // S&H clock in
// not routed: 3 ESP signal in, 8 amp out, 9 ext signal in, 12 VCA in, 15 BPF out, 16 VCA out, 20 F-V out,
//             21 initial gain, 25 VCO1+2 CV in, 28 ESP env out, 29 signal out, 30 phones, 34 ESP trig out
// Index names spelled out (works on every Ksoloti version). If you rename this object, change PatchBay below.
pidx[0]=PARAM_INDEX_PatchBay_total;pidx[1]=PARAM_INDEX_PatchBay_freq;pidx[2]=PARAM_INDEX_PatchBay_vco2freq;
pidx[3]=PARAM_INDEX_PatchBay_hpf;pidx[4]=PARAM_INDEX_PatchBay_lpf;pidx[5]=PARAM_INDEX_PatchBay_vca;
pidx[6]=PARAM_INDEX_PatchBay_eg1trig;pidx[7]=PARAM_INDEX_PatchBay_eg2trig;pidx[8]=PARAM_INDEX_PatchBay_shin;pidx[9]=PARAM_INDEX_PatchBay_shclock;
m99=m98=m6=0;h99=h98=h6=false;ev99=ev98=ev6=-1;
nrng=192837465U;shval=0;pclk=0;for(int i=0;i<14;i++)src[i]=0;
         ]]></code.init>
