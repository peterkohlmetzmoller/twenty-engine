for(int i=0;i<4;i++){kn_s[i]=0.f;kn_l[i]=0x7FFFFFFF;kn_o[i]=0;}kn_r=2654418544U;kn_f=1;
]]></code.init>
         <code.krate><![CDATA[
int32_t kn_delay=kn_upd(0,param_delay,0,134217727,524288);
int32_t kn_attack=kn_upd(1,param_attack,0,134217727,524288);
int32_t kn_release=kn_upd(2,param_release,0,134217727,524288);
int32_t kn_amount=kn_upd(3,param_amount,0,134217727,0);
kn_f=0;

int g=(inlet_mode==0)?inlet_polygate:inlet_arpgate;            // arp off: keyboard gate, arp on: arp steps
if(inlet_trig!=(int32_t)0x80000000)g=(inlet_trig>0);                   // EG1 TRIG jack patched: it replaces the keyboard gate
if(inlet_mode!=pm){pm=inlet_mode;pg=0;if(stg)stg=3;}            // mode switch: let the running sweep release
if(g&&!pg){stg=1;tmr=0;}else if(!g&&pg){stg=3;}pg=g;            /* attack from current level, no click */
int32_t sa=(kn_attack<<1)-(1<<27),sr=(kn_release<<1)-(1<<27); // unipolar knob: 0 = fastest, 64 = slowest
uint32_t ai,ri;MTOFEXTENDED(-sa,ai);MTOFEXTENDED(-sr,ri);
float ac=0.00003f+(ai*2.32e-10f)*0.35f;float rc=0.00002f+(ri*2.32e-10f)*0.25f;
if(stg==1){if(tmr++>=(uint32_t)(kn_delay>>15))stg=2;}
else if(stg==2){val+=(1.05f-val)*ac;if(val>=1.f)val=1.f;}
else if(stg==3){val+=(0.f-val)*rc-0.00001f;if(val<=0.f){val=0.f;stg=0;}}
float es=(inlet_ext!=(int32_t)0x80000000)?inlet_ext*7.4505806e-9f:val;   // FREQ jack patched: the EG1/EXT knob now scales the patched signal
int32_t o=(int32_t)(es*(kn_amount/134217728.f)*50331648.f); // EG1: up to +24 semitones, upward only
outlet_env=(int32_t)(val*134217728.f);outlet_gate=g?1:0; /* iC EG LED */
outlet_polypmod=(inlet_mode==0)?o:0;outlet_arppmod=(inlet_mode!=0)?o:0;
         ]]></code.krate>
