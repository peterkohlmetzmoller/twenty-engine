int32_t kn_hold=kn_upd(0,param_hold,0,134217727,524288);
int32_t kn_attack=kn_upd(1,param_attack,0,134217727,524288);
int32_t kn_decay=kn_upd(2,param_decay,0,134217727,524288);
int32_t kn_release=kn_upd(3,param_release,0,134217727,524288);
int32_t kn_sustain=kn_upd(4,param_sustain,0,134217727,0);
int32_t kn_lpfdepth=kn_upd(5,param_lpfdepth,0,134217727,0);
int32_t kn_hpfdepth=kn_upd(6,param_hpfdepth,0,134217727,0);
kn_f=0;

int32_t sa=(kn_attack<<1)-(1<<27),sd=(kn_decay<<1)-(1<<27),sr=(kn_release<<1)-(1<<27); // unipolar knob: 0 = fastest, 64 = slowest
uint32_t ai,di,ri;MTOFEXTENDED(-sa,ai);MTOFEXTENDED(-sd,di);MTOFEXTENDED(-sr,ri);
float ac=0.00003f+(ai*2.32e-10f)*0.35f;float dc=0.00002f+(di*2.32e-10f)*0.25f;float rc=0.00002f+(ri*2.32e-10f)*0.25f;
float sus=kn_sustain/134217728.f;uint32_t ht=kn_hold>>15;
int gt[2]={inlet_polygate,inlet_arpgate};int rt[2]={inlet_polyretrig,inlet_arpretrig};
if(inlet_trig!=(int32_t)0x80000000){int tg=(inlet_trig>0);gt[0]=gt[1]=tg;rt[0]=rt[1]=0;} // EG2 TRIG jack patched: replaces the keyboard / arp gate
for(int e=0;e<2;e++){
 if((gt[e]&&!pg[e])||rt[e]){stg[e]=1;hld[e]=ht;}pg[e]=gt[e];   /* attack from current level, no click */
 if(stg[e]==1){if(!gt[e]&&hld[e]==0)stg[e]=3;else{if(!gt[e])hld[e]--;val[e]+=(1.05f-val[e])*ac;if(val[e]>=1.f){val[e]=1.f;stg[e]=2;}}} /* gate off during the attack: Hold, then Release */
 else if(stg[e]==2){if(!gt[e]){if(hld[e]>0)hld[e]--;else stg[e]=3;}val[e]+=(sus-val[e])*dc;} // Hold: stays at sustain after key release
 else if(stg[e]==3){val[e]+=(0.f-val[e])*rc-0.00001f;if(val[e]<=0.f){val[e]=0.f;stg[e]=0;}}
}
float ld=kn_lpfdepth/134217728.f;float hd=kn_hpfdepth/134217728.f;
// HPF / LPF CUTOFF jacks patched: the EG2/EXT knobs now scale the patched signal
float hs0=val[0],hs1=val[1],ls0=val[0],ls1=val[1];
if(inlet_hpf!=(int32_t)0x80000000){hs0=hs1=inlet_hpf*7.4505806e-9f;}
if(inlet_lpf!=(int32_t)0x80000000){ls0=ls1=inlet_lpf*7.4505806e-9f;}
outlet_polylpf=(inlet_mode==0)?(int32_t)(ls0*ld*134217728.f):0;   // arp on/latch: VCO1 filter gets no EG2
outlet_polyhpf=(inlet_mode==0)?(int32_t)(hs0*hd*134217728.f):0;
outlet_arpenv=(int32_t)(val[1]*134217728.f);
outlet_arplpf=(inlet_mode!=0)?(int32_t)(ls1*ld*134217728.f):0;
outlet_arphpf=(inlet_mode!=0)?(int32_t)(hs1*hd*134217728.f):0;
outlet_env=(int32_t)(((inlet_mode==0)?val[0]:val[1])*134217728.f); // patch bay EG2 out
outlet_hold=kn_hold;outlet_attack=kn_attack;outlet_decay=kn_decay;outlet_sustain=kn_sustain;outlet_release=kn_release; // per-voice EG2 copies in MS20_Voices
         ]]></code.krate>
