      <attribs/>
      <object id="patch/object" uuid="b100000000000000000000000000000000000500">
         <sDescription>8 voices x (VCO1+VCO2). Arp off: MS-20 poly. Arp on: VCO1 organ gate + VCO2 arp. Arp latch: VCO1 chord held + arp latched.</sDescription>
         <inlets>
            <frac32.bipolar name="pmodpoly"/>
            <frac32.bipolar name="pmodarp"/>
            <frac32.positive name="eghold"/>
            <frac32.positive name="egattack"/>
            <frac32.positive name="egdecay"/>
            <frac32.positive name="egsustain"/>
            <frac32.positive name="egrelease"/>
            <frac32.bipolar name="vco2cv"/>
            <frac32.bipolar name="phmod"/>
            <int32 name="mono"/>
         </inlets>
         <outlets>
            <frac32buffer name="vco1"/>
            <frac32buffer name="vco2"/>
            <frac32buffer name="arp"/>
            <bool32 name="polygate"/>
            <bool32 name="polyretrig"/>
            <bool32 name="arpgate"/>
            <bool32 name="arpretrig"/>
            <int32 name="mode"/>
            <bool32 name="arpled"/>
            <int32 name="activevoices"/>
            <frac32.bipolar name="kbdcv"/>
            <frac32.positive name="wheel"/>
            <bool32 name="button"/>
            <int32 name="synctime"/>
            <frac32buffer name="monov1"/>
            <frac32.positive name="polyenv"/>
         </outlets>
         <displays/>
         <params>
            <int32.hradio name="vco1wave" description="0=Sin/Tri, 1=Saw (PW = 12-stage phaser amount, swept by the MG), 2=Square, 3=Noise">
               <MaxValue i="4"/>
            </int32.hradio>
            <int32.hradio name="vco1oct">
               <MaxValue i="4"/>
            </int32.hradio>
            <frac32.u.map name="pw"/>
            <frac32.u.map name="portamento" description="Multibend polyglide: 0 = off. Legato within 2 semitones glides on the held string; soft velocity = slow (up to 2.5 s at full), hard = fast"/>
            <bool32.tgl name="multitrig"/>
            <int32.hradio name="vco2wave" description="0=Tri, 1=Saw, 2=Square, 3=RingMod">
               <MaxValue i="4"/>
            </int32.hradio>
            <int32.hradio name="vco2oct">
               <MaxValue i="4"/>
            </int32.hradio>
            <frac32.s.map name="vco2fine"/>
            <frac32.s.map name="vco2semi"/>
            <frac32.u.map name="arpmode" description="0-18 Off (MS-20 poly), 18-42 Arp (VCO1 organ gate), 42-64 Arp Latch (VCO1 chord held)"/>
            <frac32.u.map name="arprate" description="Arp Tempo (Musical Curve)"/>
            <int32.hradio name="arpoct">
               <MaxValue i="4"/>
            </int32.hradio>
            <int32.hradio name="arporder">
               <MaxValue i="4"/>
            </int32.hradio>
