         <code.midihandler><![CDATA[
uint8_t st=status&0xF0;
if((st==MIDI_NOTE_ON)&&(data2>0)){
 bool f=false;for(int i=0;i<nh;i++){if(h[i]==data1)f=true;}if(!f&&nh<16)h[nh++]=data1;
 if(mode==2){
  if(zk||(kclk-lon)>180){                     /* new chord: after a full release, or more than 60 ms after the previous note-on */
   na=0;zk=false;cid++;
   for(int i=0;i<NV;i++){if(vg[i]&&vc[i]!=cid){if(!vk[i])vg[i]=0;else vu[i]=1;}} /* old chord: latched notes stop now, keys still down stop when released */
  }
  bool af=false;for(int i=0;i<na;i++){if(a[i]==data1)af=true;}
  if(!af&&na<16){a[na++]=data1;for(int i=0;i<na-1;i++){for(int j=i+1;j<na;j++){if(a[j]<a[i]){uint8_t t=a[i];a[i]=a[j];a[j]=t;}}}}
 }
 lon=kclk;
 if(!mono_on){                              /* mono: the control-rate code plays one voice from the held keys */
 float np=(float)((data1-64)<<21);ln=np;
 int lg=-1;
 if(porta>0.002f){                            // Multibend: legato within 2 semitones of a held string glides on that string
  int bd=99;uint32_t bt=0;
  for(int i=0;i<NV;i++){
   if(vg[i]&&sc[i]>0&&(kclk-vt[i])>=90){     // 90 control ticks = 30 ms chord window: chords never glide into each other
    int d=data1-vn[i];if(d<0)d=-d;
    if(d<=2&&(d<bd||(d==bd&&vlt[i]>bt))){bd=d;bt=vlt[i];lg=i;}  // nearest wins; tie -> most recently touched string
   }
  }
 }
 if(lg>=0){
  if(sc[lg]<SD)stk[lg][sc[lg]++]=data1;
  vlt[lg]=++acnt;vn[lg]=data1;vc[lg]=cid;vu[lg]=0;
  float gmax=2500.f*porta;float gmin=gmax*0.0667f;                   // script ratio 20 : 300 ms; max 2.5 s at full knob
  float gms=gmin+(127-data2)*(1.f/127.f)*(gmax-gmin);               // soft hit = slow, hard hit = fast
  float tk=gms*3.f;if(tk<1.f)tk=1.f;                                // 3 control ticks per ms
  gs[lg]=vp[lg];tg[lg]=np;gpos[lg]=0.f;ginc[lg]=1.f/tk;gmix[lg]=data2*(1.f/127.f);gon[lg]=true; // no new attack: the string bends
 }else{
  int tv=-1;for(int i=0;i<NV;i++){if(vn[i]==data1&&vg[i]){tv=i;break;}}
  if(tv==-1){for(int i=0;i<NV;i++){if(!vg[i]&&ve[i]<=0.f&&vgn[i]<0.0001f){tv=i;break;}}}
  if(tv==-1){uint32_t ma=0xFFFFFFFF;for(int i=0;i<NV;i++){if(!vg[i]&&va[i]<ma){ma=va[i];tv=i;}}}
  if(tv==-1){uint32_t ma=0xFFFFFFFF;for(int i=0;i<NV;i++){if(va[i]<ma){ma=va[i];tv=i;}}}
  if(tv>=0){
   vn[tv]=data1;vg[tv]=1;vk[tv]=1;vd[tv]=(data2>=120)?1:0;vs[tv]=1;vh[tv]=holdt;va[tv]=++acnt;rp=1;
   vp[tv]=np;tg[tv]=np;gon[tv]=false;stk[tv][0]=data1;sc[tv]=1;vt[tv]=kclk;vlt[tv]=++acnt;vc[tv]=cid;vu[tv]=0;  // new attack: no glide
  }
 }
 }
}else if((st==MIDI_NOTE_OFF)||((st==MIDI_NOTE_ON)&&(data2==0))){
 for(int i=0;i<nh;i++){if(h[i]==data1){for(int j=i;j<nh-1;j++)h[j]=h[j+1];nh--;break;}}
 if(nh==0){zk=true;if(mode!=2)na=0;}
 for(int i=0;i<NV;i++){                     // remove the key from its string's stack
  if(sc[i]<=0)continue;
  int w=0;bool rm=false;
  for(int r=0;r<sc[i];r++){if(!rm&&stk[i][r]==data1){rm=true;continue;}stk[i][w++]=stk[i][r];}
  if(!rm)continue;
  sc[i]=w;
  if(w==0){vk[i]=0;vd[i]=0;if(mode!=2||vu[i])vg[i]=0;vu[i]=0;}     // last key of the string up (latch keeps it sounding, unless a newer chord replaced it)
  else{int top=stk[i][w-1];
   if(top!=vn[i]){vn[i]=top;vlt[i]=++acnt;gs[i]=vp[i];tg[i]=(float)((top-64)<<21);gpos[i]=0.f;ginc[i]=1.f/270.f;gmix[i]=0.f;gon[i]=true;} // glide back to the key still held: 90 ms, soft curve
  }
  break;
 }
}else if(st==MIDI_CONTROL_CHANGE){
 if(data1==1)mw=data2/127.f;                                       // mod wheel -> vibrato
 else{
  // MS-20 iC rotary switches send 0/43/85/127; Ksoloti's built-in CC mapping can't decode that, so map to positions 0..3 here
  int rz=(data2<22)?0:((data2<64)?1:((data2<106)?2:3));
  // PExParameterChange = the same call Ksoloti's built-in CC assignment uses, so the knob also moves in the editor
  // Index names are spelled out (works on every Ksoloti version). If you rename this object, change MS20__Voices below to the new name (underscores doubled).
  if(data1==77)PExParameterChange(&parent->PExch[PARAM_INDEX_MS20__Voices_vco1wave],rz,0xFFFD);       // VCO1 waveform
  else if(data1==15)PExParameterChange(&parent->PExch[PARAM_INDEX_MS20__Voices_vco1oct],rz,0xFFFD);   // VCO1 scale 32'..4'
  else if(data1==82)PExParameterChange(&parent->PExch[PARAM_INDEX_MS20__Voices_vco2wave],rz,0xFFFD);  // VCO2 waveform
  else if(data1==22)PExParameterChange(&parent->PExch[PARAM_INDEX_MS20__Voices_vco2oct],rz,0xFFFD);   // VCO2 scale 32'..4'
 }
}else if(st==0xD0){
 btn_phys=(data1>0)?1:0;                                           // MS-20 iC momentary switch = channel pressure (delay layer is handled in ESP_Layer)
}
         ]]></code.midihandler>
