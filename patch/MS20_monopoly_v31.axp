         <includes/>
         <code.declaration><![CDATA[
// ---- poly voices: VCO1 + VCO2 per voice ----
static const int NV=8; // VOICE COUNT: lower to 6 if the DSP load is too high
float ph1[NV],ph2[NV],inc1[NV],inc2[NV],ve[NV],vgn[NV],vp[NV],dtn[NV],dtn2[NV],drf[NV],drt[NV];
int32_t vn[NV];int vg[NV],vk[NV],vd[NV],vs[NV];uint32_t va[NV],vh[NV];
uint32_t acnt,rng,drng,holdt;float pk,cc_pw,pws,ln;int hp,btn_dub,rp,btn_phys;
float mw,mws,vph; // mod wheel vibrato
uint32_t lon;int cid;int vc[NV];uint8_t vu[NV];
volatile bool mono_on;int mg_was,mhp;float mtg,mpos,p1a; /* mono mode (KBD CV -> VCO1+2 CV IN patched) */ /* latch: chord id per voice, vu = release when its key goes up */
// ---- Multibend polyglide (pedal steel legato, from the Kontakt script) ----
static const int SD=4;                       // held-key stack per string
uint8_t stk[NV][SD];int sc[NV];uint32_t vt[NV],vlt[NV],kclk;
float tg[NV],gs[NV],gpos[NV],ginc[NV],gmix[NV];bool gon[NV];float porta;
inline float gcurve(float x,float m){        // soft / hard glide curves (33 points), blended by velocity
 static const float S[33]={0.000f,0.094f,0.180f,0.258f,0.329f,0.394f,0.453f,0.506f,0.555f,0.600f,0.640f,0.677f,0.711f,0.741f,0.769f,0.795f,0.818f,0.839f,0.858f,0.875f,0.891f,0.905f,0.918f,0.930f,0.941f,0.951f,0.960f,0.968f,0.976f,0.983f,0.989f,0.994f,1.000f};
 static const float H[33]={0.000f,0.221f,0.394f,0.528f,0.632f,0.714f,0.777f,0.827f,0.865f,0.895f,0.918f,0.936f,0.951f,0.962f,0.970f,0.977f,0.982f,0.986f,0.989f,0.992f,0.994f,0.995f,0.996f,0.997f,0.998f,0.998f,0.999f,0.999f,0.999f,0.999f,1.000f,1.000f,1.000f};
 float f=x*32.f;int i=(int)f;if(i>=32)return 1.f;float r=f-(float)i;
 float s=S[i]+(S[i+1]-S[i])*r;float h=H[i]+(H[i+1]-H[i])*r;return s+(h-s)*m;}
// ---- arp (VCO2 mono) ----
uint8_t h[16],a[16];int nh,na;float ap;int am,amp,mode;uint32_t acc,ledp,arng;int ai,ao;bool aup,zk;float p2,drf2,drt2;
// ---- 12-stage phaser (Moogerfooger MF-103 style) on the VCO1 bus: saw + PW ----
float ap_s[12],ph_fb,ph_a,ph_da;bool phwas;
inline float ftan(float x){float x2=x*x;return x*(945.f-105.f*x2+x2*x2)/(945.f-420.f*x2+15.f*x2*x2);} // tan() without libm, <0.01 cent error up to 0.42*fs
inline float softc(float x){if(x>1.5f)return 1.f;if(x<-1.5f)return -1.f;return x-0.148148f*x*x*x;}   // soft clip in the resonance loop (analog-style, no division) (fold gain max 4.5)
inline float pblp(float t,float dt){if((t-dt)*((1.f-dt)-t)>0.f)return 0.f; /* one compare for the common case (identical result) */ if(t<dt){t/=dt;return t+t-t*t-1.f;}else if(t>1.f-dt){t=(t-1.f)/dt;return t*t+t+t+1.f;}return 0.f;}
inline float bh(float p){float x=p*2.f-1.f;float ax=x<0.f?-x:x;return(16.f*x*(1.f-ax))/(5.f-4.f*ax*(1.f-ax));}
         
/* ---- knob feel: every move glides (~15 ms); some knobs land a hair off (+-half a knob step), fixed until the next move ---- */
float kn_s[1];int32_t kn_l[1],kn_o[1];uint32_t kn_r;int kn_f;
inline int32_t kn_upd(int i,int32_t p,int32_t lo,int32_t hi,int32_t half){
 if(p!=kn_l[i]){kn_l[i]=p;if(half){kn_r=kn_r*1664525U+1013904223U;kn_o[i]=(int32_t)(((int64_t)(int32_t)kn_r*half)>>31);}} /* knob moved: new tiny offset */
 int32_t tg=p+kn_o[i];if(tg<lo)tg=lo;if(tg>hi)tg=hi;
 if(kn_f)kn_s[i]=(float)tg;else kn_s[i]+=((float)tg-kn_s[i])*0.055f;    /* first tick: no glide from zero */
 return (int32_t)kn_s[i];
}
]]></code.declaration>
         <code.init><![CDATA[
acnt=0;rng=1357911U;pk=0.f;ln=0.f;hp=0;cc_pw=0.f;pws=0.f;btn_dub=0;btn_phys=0;rp=0;holdt=0;mw=mws=vph=0.f;for(int k=0;k<12;k++)ap_s[k]=0.f;ph_fb=ph_a=ph_da=0.f;phwas=false;
for(int i=0;i<NV;i++){ph1[i]=i*0.125f;ph2[i]=0.31f+i*0.0625f;inc1[i]=inc2[i]=0.009f;ve[i]=vgn[i]=vp[i]=0.f;vn[i]=60;vg[i]=vk[i]=vd[i]=vs[i]=0;va[i]=vh[i]=0;}
drng=24681357U;for(int i=0;i<NV;i++){drng=drng*196314165U+907633515U;dtn[i]=(int32_t)drng*2.93e-5f;drng=drng*196314165U+907633515U;dtn2[i]=(int32_t)drng*2.93e-5f;drf[i]=drt[i]=0.f;} // static detune +/-3 cents per VCO (2^21 = 1 semitone)
for(int i=0;i<NV;i++){sc[i]=0;vt[i]=vlt[i]=0;tg[i]=gs[i]=ginc[i]=gmix[i]=0.f;gpos[i]=1.f;gon[i]=false;}kclk=0;porta=0.f;
lon=0;cid=0;for(int i=0;i<NV;i++){vc[i]=0;vu[i]=0;}
mono_on=false;mg_was=0;mhp=0;mtg=mpos=0.f;p1a=0.f;
nh=na=0;ap=60.f;am=amp=mode=0;acc=0;ledp=0;arng=1357911U;ai=ao=0;aup=zk=true;p2=0.f;drf2=drt2=0.f;
         
for(int i=0;i<1;i++){kn_s[i]=0.f;kn_l[i]=0x7FFFFFFF;kn_o[i]=0;}kn_r=2654468715U;kn_f=1;
]]></code.init>
         <code.krate><![CDATA[
int32_t kn_pw=kn_upd(0,param_pw,0,134217727,524288);
kn_f=0;

// ===== MODE: 0 = MS-20 poly, 1 = Arp (VCO1 organ gate), 2 = Arp latch (VCO1 chord held) =====
int32_t mo=param_arpmode>>21;am=(mo<18)?0:((mo<42)?1:2);
if(amp==2&&am!=2){for(int v=0;v<NV;v++){if(!vk[v])vg[v]=0;}}                              // leaving latch: let go of latched notes
if(amp!=0&&am==0){for(int v=0;v<NV;v++){vs[v]=vg[v]?2:(ve[v]>0.f?3:0);vh[v]=0;}}            // back to MS-20: held notes sit in sustain, others release
amp=am;mode=am;outlet_mode=am;

// ===== ARP (VCO2 mono) =====
if(am==2){ledp+=2863311U;outlet_arpled=(ledp&0x80000000)?1:0;}else{outlet_arpled=(am==1)?1:0;}
if(am<2&&nh==0){na=0;}if(am==1){na=nh;for(int i=0;i<nh;i++)a[i]=h[i];}
float n=param_arprate*7.45e-9f;float n2=n*n;float hz=0.5f+n2*20.f+(n2*n2*n)*150.f;uint32_t aper=(uint32_t)(3000.f/hz);
int dtg=0;bool gt=false;acc++;
if(am>0&&na>0){
 if(acc>=aper){
  acc=0;dtg=1;int mxo=(param_arpoct&3)+1;int ord=param_arporder;
  if(ord==0){ai++;if(ai>=na){ai=0;ao++;if(ao>=mxo)ao=0;}}
  else if(ord==1){ai--;if(ai<0){ai=na-1;ao--;if(ao<0)ao=mxo-1;}}
  else if(ord==2){if(aup){ai++;if(ai>=na){ao++;if(ao>=mxo){ao=mxo-1;aup=false;ai=(na>1)?na-2:0;}else ai=0;}}else{ai--;if(ai<0){ao--;if(ao<0){ao=0;aup=true;ai=(na>1)?1:0;}else ai=na-1;}}}
  else{arng=arng*196314165U+907633515U;ai=(arng>>16)%na;ao=(arng>>24)%mxo;}
  if(ai>=na)ai=na-1;if(ai<0)ai=0;if(ao>=mxo)ao=mxo-1;if(ao<0)ao=0;
  ap=(float)a[ai]+(float)(ao*12);
 }
 gt=(acc<(aper*3)/4); // 75% duty: gate drops each step so the envelopes retrigger
}
outlet_arpgate=gt?1:0;outlet_arpretrig=dtg?1:0;
outlet_synctime=(am>0)?(int32_t)(aper*48U):0; // arp on: delay = 3 arp steps (16ths) = dotted 8th, in samples (step ticks x 16 samples x 3); 0 = arp off
arng=arng*196314165U+907633515U;if((arng>>20)==0)drt2=(int32_t)arng*7.8e-6f;drf2+=0.0005f*(drt2-drf2); // arp VCO2 slow drift, +/-0.8 cent

// ===== POLY VOICES =====
int w1=param_vco1wave;int w2=param_vco2wave;
int32_t oct1=(param_vco1oct-2)*(12<<21);   /* VCO1 32' 16' 8' 4' (one octave below VCO2, as on the MS-20) */
int32_t oct2=(param_vco2oct-1)*(12<<21)+(param_vco2fine>>7)+((param_vco2semi*5+(1<<26))>>27)*(1<<21); /* VCO2 PITCH: -5..+5 semitones, as on the panel */
float rpw=(kn_pw*7.45e-9f)+cc_pw;if(rpw>1.f)rpw=1.f;pws+=0.12f*(rpw-pws);
float dty=0.5f*(1.f-pws*1.015f);if(dty<0.f)dty=0.f;
// EG2 settings arrive from the EG2 object (knobs are unipolar: 0 = fastest, 64 = slowest)
int32_t sa=(inlet_egattack<<1)-(1<<27),sd=(inlet_egdecay<<1)-(1<<27),sr=(inlet_egrelease<<1)-(1<<27);
uint32_t a_i,d_i,r_i;MTOFEXTENDED(-sa,a_i);MTOFEXTENDED(-sd,d_i);MTOFEXTENDED(-sr,r_i);
float eac=0.00003f+(a_i*2.32e-10f)*0.35f;float edc=0.00002f+(d_i*2.32e-10f)*0.25f;float erc=0.00002f+(r_i*2.32e-10f)*0.25f;
float sus=inlet_egsustain/(float)(1<<27);holdt=inlet_eghold>>15;
porta=param_portamento*7.45e-9f;kclk++;     // Multibend polyglide amount (read by the MIDI handler); control-tick clock for the chord window
// saw + PW = 12-stage phaser: 0 = clean saw, up = more phasing. The MG (its shape + rate) sweeps it.
bool phon=(w1==1&&pws>0.0005f);float phmix=0.f,phres=0.f;
if(phon){
 phmix=(pws<0.5f)?pws:0.5f;                 // wet mix 0..50 % = notch depth, full notches from half-way
 phres=0.15f+0.55f*pws;                      // resonance rises with the amount (MF-103 style peaks)
 float mg=inlet_phmod*7.4505806e-9f;if(mg>1.f)mg=1.f;if(mg<-1.f)mg=-1.f;
 int32_t pp=(13<<21)+(int32_t)(mg*pws*36.f*2097152.f); // centre ~700 Hz, sweep up to +/-3 octaves (six-octave range)
 uint32_t pf;MTOFEXTENDED(pp,pf);float fn=pf*2.3283e-10f;if(fn>0.40f)fn=0.40f;if(fn<0.0005f)fn=0.0005f;
 float tt=ftan(3.14159265f*fn);float tgt=(tt-1.f)/(tt+1.f); // first-order allpass coefficient
 if(!phwas){for(int k=0;k<12;k++)ap_s[k]=0.f;ph_fb=0.f;ph_a=tgt;}
 ph_da=(tgt-ph_a)*0.0625f;                  // glide the coefficient across the 16-sample block (no zipper)
}
phwas=phon;
// mod wheel (CC1) vibrato: its own ~4.6 Hz sine, depth follows the wheel on a squared curve, up to +/-50 cents
mws+=0.004f*(mw-mws);vph+=4.6f/3000.f;  /* 4.6 Hz: slower, still a singing vibrato */if(vph>=1.f)vph-=1.f;
int32_t vib=(int32_t)(bh(vph)*(mws*mws*0.5f)*2097152.f);
int32_t v2cv=(inlet_vco2cv==(int32_t)0x80000000)?0:inlet_vco2cv; // patch bay VCO2 FREQ in (pitch units: 1<<21 per semitone)
/* ===== MONO: lowest held note, single trigger, classic portamento (arp modes: VCO1 plays the arp with VCO2) ===== */
bool mn=(inlet_mono!=0);
if(mn!=mono_on){for(int v=0;v<NV;v++){vg[v]=0;sc[v]=0;gon[v]=false;}mg_was=0;mono_on=mn;}
if(mono_on){
 for(int v=1;v<NV;v++)vg[v]=0;
 if(am==0){
  int lo=128;for(int i=0;i<nh;i++)if(h[i]<lo)lo=h[i];
  if(nh>0){
   mtg=(float)((lo-64)<<21);
   if(!mg_was){vs[0]=1;vh[0]=holdt;va[0]=++acnt;if(!mhp){mpos=mtg;mhp=1;}} /* first key: attack; legato keys only change pitch */
   vg[0]=1;vn[0]=lo;
  }else vg[0]=0;
  mg_was=(nh>0)?1:0;
  if(porta<0.002f)mpos=mtg;else{float tau=0.002f+porta*porta*1.5f;mpos+=(mtg-mpos)*(1.f/(3000.f*tau));} /* portamento knob: 0 = off, full = ~1.5 s */
  tg[0]=mpos;gon[0]=false;ln=mpos;rp=0;
 }else{vg[0]=0;mg_was=0;}
}
int act=0,ag=0;
for(int v=0;v<NV;v++){
 drng=drng*196314165U+907633515U;if((drng>>20)==0)drt[v]=(int32_t)drng*7.8e-6f;drf[v]+=0.0005f*(drt[v]-drf[v]); // slow drift, +/-0.8 cent
 if(vg[v])ag=1;                                     // velocity no longer triggers the dub splash
 if(am==0){
  // MS-20 EG2 per voice: Attack -> Decay to Sustain; after key release Hold keeps it at Sustain, then Release
  if(vs[v]==1){if(!vg[v]&&vh[v]==0)vs[v]=3;else{if(!vg[v])vh[v]--;ve[v]+=(1.05f-ve[v])*eac;if(ve[v]>=1.f){ve[v]=1.f;vs[v]=2;}}} /* key up during the attack: Hold, then Release from where it is */
  else if(vs[v]==2){if(!vg[v]){if(vh[v]>0)vh[v]--;else vs[v]=3;}ve[v]+=(sus-ve[v])*edc;}
  else if(vs[v]==3){ve[v]+=(0.f-ve[v])*erc-0.00001f;if(ve[v]<=0.f){ve[v]=0.f;vs[v]=0;}}
 }else{
  ve[v]=vg[v]?1.f:0.f; // organ gate: on/off, the srate smoother only removes the click
 }
 if(ve[v]>0.f||vgn[v]>0.00005f){
  act++;
  if(gon[v]){gpos[v]+=ginc[v];if(gpos[v]>=1.f){gpos[v]=1.f;gon[v]=false;}vp[v]=gs[v]+(tg[v]-gs[v])*gcurve(gpos[v],gmix[v]);} // polyglide
  else vp[v]=tg[v];
  int32_t q1=__SSAT((int32_t)(vp[v]+dtn[v]+drf[v])+oct1+inlet_pmodpoly+vib,28);
  uint32_t f1;MTOFEXTENDED(q1,f1);inc1[v]=f1*2.3283e-10f;if(inc1[v]>0.48f)inc1[v]=0.48f;
  if(am==0){
   int32_t q2=__SSAT((int32_t)(vp[v]+dtn2[v]+drf[v])+oct2+inlet_pmodpoly+vib+v2cv,28);
   uint32_t f2;MTOFEXTENDED(q2,f2);inc2[v]=f2*2.3283e-10f;if(inc2[v]>0.48f)inc2[v]=0.48f;
  }
 }
}
outlet_polygate=ag;outlet_activevoices=act;
{float me=0.f;for(int v=0;v<NV;v++)if(ve[v]>me)me=ve[v];outlet_polyenv=(int32_t)(me*134217728.f);} /* loudest voice envelope: gates the poly filter output */
outlet_polyretrig=(param_multitrig&&am==0)?rp:0;rp=0;
outlet_kbdcv=(int32_t)ln;outlet_wheel=(int32_t)(mws*134217728.f);outlet_button=btn_phys; // patch bay sources
         ]]></code.krate>
         <code.srate><![CDATA[
float ns=0.f;
if(w1==3){rng=rng*196314165U+907633515U;float w_n=(int32_t)rng*4.6566e-10f;pk=0.96f*pk+0.04f*w_n;ns=w_n*0.45f+pws*(pk*1.5f-w_n*0.45f);} // noise only when VCO1 is on noise
float s1=0.f,s2=0.f;
for(int v=0;v<NV;v++){
 vgn[v]+=0.02f*(ve[v]-vgn[v]); // ~1 ms de-click smoother on every voice amplitude
 if(vgn[v]>0.00005f){
  float q=ph1[v]+inc1[v];if(q>=1.f)q-=1.f;ph1[v]=q;float dt=inc1[v];float o=0.f;
  if(w1==0){float sw=bh(q);float tw=(q<0.5f)?(q*4.f-1.f):(3.f-q*4.f);o=sw+pws*(tw-sw);}
  else if(w1==1){o=(2.f*q-1.f)-pblp(q,dt);
   }
  else if(w1==2){if(dty>0.001f){float r=(q<dty)?1.f:-1.f;r+=pblp(q,dt);float psq=q-dty;if(psq<0.f)psq+=1.f;r-=pblp(psq,dt);o=(r-(2.f*dty-1.f))*0.85f;}}
  else{o=ns;}
  s1+=o*(vgn[v]*0.15f);
  if(am==0){
   float r=ph2[v]+inc2[v];if(r>=1.f)r-=1.f;ph2[v]=r;float d2=inc2[v];float o2;
   if(w2==0)o2=(r<0.5f)?(r*4.f-1.f):(3.f-r*4.f);
   else if(w2==1)o2=(2.f*r-1.f)-pblp(r,d2);
   else if(w2==2){o2=(r<0.5f)?1.f:-1.f;o2+=pblp(r,d2);float rs=r-0.5f;if(rs<0.f)rs+=1.f;o2-=pblp(rs,d2);}
   else{o2=o*((r<0.5f)?1.f:-1.f);} // ring mod per voice: VCO1 x VCO2 square
   s2+=o2*(vgn[v]*0.15f);
  }
 }
}
if(phon){                                    // 12 allpass stages + resonance on the summed VCO1 voices
 ph_a+=ph_da;float a=ph_a;float y=s1+phres*softc(ph_fb);
 for(int k=0;k<12;k++){float o=a*y+ap_s[k];ap_s[k]=y-a*o;y=o;}
 ph_fb=y;s1=s1*(1.f-phmix)+y*phmix;
