float ao2=0.f;
if(am>0){
 uint32_t f;MTOFEXTENDED(__SSAT((int32_t)((ap-64.f)*2097152.f)+oct2+inlet_pmodarp+(int32_t)drf2+vib+v2cv,28),f);
 float dt=f*2.3283e-10f;if(dt>0.48f)dt=0.48f;p2+=dt;if(p2>=1.f)p2-=1.f;
 if(w2==0)ao2=(p2<0.5f)?(p2*4.f-1.f):(3.f-p2*4.f);
 else if(w2==1)ao2=(2.f*p2-1.f)-pblp(p2,dt);
 else if(w2==2){ao2=(p2<0.5f)?1.f:-1.f;ao2+=pblp(p2,dt);float ps=p2-0.5f;if(ps<0.f)ps+=1.f;ao2-=pblp(ps,dt);}
 else{ao2=(mono_on?ao1:s1*2.5f)*((p2<0.5f)?1.f:-1.f);} // ring mod against VCO1 (organ chord, or the mono arp VCO1)
