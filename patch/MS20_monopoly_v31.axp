   <patchobj type="patch/object" uuid="b1000000000000000000000000000301" name="MG_Morphing_LFO" x="112" y="714">
      <params>
         <frac32.u.map name="rate" MidiCC="27" value="0.5"/>
         <frac32.u.map name="shape" MidiCC="76" value="0.0"/>
         <frac32.u.map name="pitchmod" MidiCC="12" value="0.0"/>
         <frac32.u.map name="lpfmod" MidiCC="85" value="0.0"/>
         <frac32.u.map name="hpfmod" MidiCC="30" value="0.0"/>
      </params>
      <attribs/>
      <object id="patch/object" uuid="b1000000000000000000000000000301">
         <inlets>
            <frac32.bipolar name="total"/>
         </inlets>
         <outlets>
            <frac32.bipolar name="pmod"/>
            <frac32.bipolar name="lpfmod"/>
            <frac32.bipolar name="hpfmod"/>
            <frac32.bipolar name="tri"/>
            <frac32.bipolar name="sq"/>
            <frac32.bipolar name="shaped"/>
         </outlets>
         <displays/>
         <params>
            <frac32.u.map name="rate"/>
            <frac32.u.map name="shape"/>
            <frac32.u.map name="pitchmod"/>
            <frac32.u.map name="lpfmod"/>
            <frac32.u.map name="hpfmod"/>
         </params>
         <attribs/>
         <includes/>
         <code.declaration><![CDATA[uint32_t ph, phf, rng; float r_t, r_s1, r_s2, sr; int in;
/* ---- knob feel: every move glides (~15 ms); some knobs land a hair off (+-half a knob step), fixed until the next move ---- */
float kn_s[5];int32_t kn_l[5],kn_o[5];uint32_t kn_r;int kn_f;
inline int32_t kn_upd(int i,int32_t p,int32_t lo,int32_t hi,int32_t half){
 if(p!=kn_l[i]){kn_l[i]=p;if(half){kn_r=kn_r*1664525U+1013904223U;kn_o[i]=(int32_t)(((int64_t)(int32_t)kn_r*half)>>31);}} /* knob moved: new tiny offset */
 int32_t tg=p+kn_o[i];if(tg<lo)tg=lo;if(tg>hi)tg=hi;
 if(kn_f)kn_s[i]=(float)tg;else kn_s[i]+=((float)tg-kn_s[i])*0.055f;    /* first tick: no glide from zero */
 return (int32_t)kn_s[i];
}
]]></code.declaration>
         <code.init><![CDATA[ph=phf=0; rng=987654321U; r_t=r_s1=r_s2=sr=0.f; in=0;
for(int i=0;i<5;i++){kn_s[i]=0.f;kn_l[i]=0x7FFFFFFF;kn_o[i]=0;}kn_r=2654414431U;kn_f=1;
]]></code.init>
         <code.krate><![CDATA[
int32_t kn_rate=kn_upd(0,param_rate,0,134217727,524288);
int32_t kn_shape=kn_upd(1,param_shape,0,134217727,524288);
int32_t kn_pitchmod=kn_upd(2,param_pitchmod,0,134217727,0);
int32_t kn_lpfmod=kn_upd(3,param_lpfmod,0,134217727,0);
int32_t kn_hpfmod=kn_upd(4,param_hpfmod,0,134217727,0);
kn_f=0;

int32_t rr=(kn_rate<<1)-(1<<27); // unipolar knob, same frequency range as before (CC27 maps identically)
if(!in){sr=rr;in=1;}sr+=0.22f*(rr-sr);
uint32_t f;MTOFEXTENDED((int32_t)sr,f);uint32_t inc=(f>>4)+40000U;
uint32_t op=ph;ph+=inc;phf+=inc*3U+(inc>>1);
float xs=(int32_t)ph*4.6566e-10f;float sw=4.f*xs*(1.f-(xs<0.f?-xs:xs));
float sq=sw*12.f;if(sq>1.f)sq=1.f;if(sq<-1.f)sq=-1.f;
rng=rng*196314165U+907633515U;if(ph<op||((rng&0x7F)==0))r_t=(int32_t)rng*4.6566e-10f;
float slw=0.004f+((inc>>14)*0.00015f);if(slw>0.25f)slw=0.25f;
r_s1+=slw*(r_t-r_s1);r_s2+=slw*(r_s1-r_s2);
float xf=(int32_t)phf*4.6566e-10f;float fs=4.f*xf*(1.f-(xf<0.f?-xf:xf));
float wf=r_s2*1.1f+0.25f*fs*r_s1;if(wf>1.f)wf=1.f;if(wf<-1.f)wf=-1.f;
float sh=kn_shape*7.45e-9f;float lfo=0.f;
if(sh<=0.5f){float m=sh*2.f;lfo=sw*(1.f-m)+sq*m;}else{float m=(sh-0.5f)*2.f;lfo=sq*(1.f-m)+wf*m;}
outlet_tri=(int32_t)(sw*134217728.f);outlet_sq=(int32_t)(sq*134217728.f); // MG outs for the patch bay
if(inlet_total!=(int32_t)0x80000000){lfo=inlet_total*7.4505806e-9f;if(lfo>1.f)lfo=1.f;if(lfo<-1.f)lfo=-1.f;} // TOTAL jack patched: MG/T.EXT knobs scale the patched signal
outlet_shaped=(int32_t)(lfo*134217728.f); // shaped MG -> phaser sweep
float pd=kn_pitchmod/134217728.f;float p2=pd*pd;float p4=p2*p2;outlet_pmod=(int32_t)(lfo*(1.5f*p2+34.5f*p4)*2097152.f);
float ld=kn_lpfmod/134217728.f;outlet_lpfmod=(int32_t)(lfo*ld*134217728.f);
float hd=kn_hpfmod/134217728.f;outlet_hpfmod=(int32_t)(lfo*hd*134217728.f);
         ]]></code.krate>
      </object>
   </patchobj>
