// MS-20 iC patch panel: CC99 = event type, CC98 / CC6 = the two jack numbers (NRPN-style triple)
if((status&0xF0)==MIDI_CONTROL_CHANGE){
 if(data1==99){m99=data2;h99=true;h98=h6=false;}   // 99 starts a new event (standard NRPN order), dropping any stray 98/6
 else if(data1==98){m98=data2;h98=true;}
 else if(data1==6){m6=data2;h6=true;}
 if((data1==99||data1==98||data1==6)&&h99&&h98&&h6){
  h99=h98=h6=false;ev99=m99;ev98=m98;ev6=m6;
  patchEvent(m99,m98,m6);
 }
}
