   <patchobj type="patch/object" uuid="b100000000000000000000000000000000000900" name="MS20iC_LEDs" x="1246" y="252">
      <params/>
      <attribs/>
      <object id="patch/object" uuid="b100000000000000000000000000000000000900">
         <sDescription>Drives the MS-20 iC panel LEDs over the Ksoloti USB host port: MG rate LED = MG square, EG LED = EG1 gate, ESP PEAK LED = arp tempo whenever the arp is switched on (free-running, locked to the arp steps while notes play). Message per LED change: F0 42 40 6E 01 01 [led] [3F on / 1F off] F7 (0 rate, 1 EG, 2 PEAK, 3 TRIG, 4 volume).</sDescription>
         <inlets>
            <frac32.bipolar name="rate"/>
            <bool32 name="gate"/>
            <bool32 name="arpstep"/>
            <int32 name="mode"/>
            <int32 name="synctime"/>
            <int32 name="power"/>
            <int32 name="poweron"/>
         </inlets>
         <outlets/>
         <displays/>
         <params/>
         <attribs/>
         <includes/>
         <code.declaration><![CDATA[
// MS-20 iC LED numbers: 0 MG rate, 1 EG, 2 ESP PEAK, 3 ESP TRIG, 4 volume
static const int NL=5;
int anim,lpon;int apos,adur,anext,ablink; /* anim: power-on light show position in control ticks, -1 = not running */
uint8_t want[NL],sent[NL];int hold[NL];
uint32_t tick,lastt,tint,aph;int ton,prevst,refresh,ri,gap,rr;
void sendLed(int i,int on){
 uint8_t m[9]={0xF0,0x42,0x40,0x6E,0x01,0x01,(uint8_t)i,(uint8_t)(on?0x3F:0x1F),0xF7};
 MidiSendSysEx(MIDI_DEVICE_USB_HOST,1,m,9);   /* USB host port 1 = the iC */
}
         ]]></code.declaration>
         <code.init><![CDATA[
for(int i=0;i<NL;i++){want[i]=0;sent[i]=2;hold[i]=0;} // sent=2 (unknown): every LED is set once at patch start
anim=-1;lpon=0;apos=0;adur=0;anext=0;ablink=0;tick=lastt=tint=aph=0;ton=0;prevst=0;refresh=0;ri=0;gap=0;rr=0;
         ]]></code.init>
         <code.krate><![CDATA[
tick++;
want[0]=(inlet_rate>0)?1:0;                       // MG rate LED: MG square
want[1]=inlet_gate?1:0;                           // EG LED: the gate EG1 follows (keys, arp steps in arp mode, or EG1 TRIG jack)
/* ESP PEAK LED: arp tempo whenever the arp is on, with or without notes.
   synctime = 3 arp steps in samples (aper*48), so one step = synctime/48 control ticks */
uint32_t stp=(uint32_t)inlet_synctime/48U;
if(inlet_mode==0||stp==0){aph=0;want[2]=0;}
else{
 if(inlet_arpstep&&!prevst)aph=0;                 // notes playing: lock the blink to the real arp steps
 else{aph++;if(aph>=stp)aph=0;}                   // no notes: free-running at the arp rate
 uint32_t lit=stp>>1;if(lit>150)lit=150;if(lit<15)lit=15;   // flash for half a step, at most 50 ms
 want[2]=(aph<lit)?1:0;
}
prevst=inlet_arpstep;
want[3]=0;                                        // ESP TRIG LED: unused for now
want[4]=1;
if(!inlet_power){for(int k=0;k<NL;k++)want[k]=0;}   /* volume knob off: the whole panel goes dark */
/* volume knob switched on: 3.4 s light show - a chase that speeds up, then all LEDs blinking faster and faster */
if(inlet_poweron!=lpon){lpon=inlet_poweron;if(anim<0)anim=0;}
if(anim>=0){
 if(anim==0){apos=-1;adur=450;anext=0;ablink=0;}
 if(anim<6600){                                  /* 0-2.2 s chase: 150 ms per LED, 10 % faster each step, down to 22 ms */
  if(anim>=anext){apos=(apos+1)%NL;anext=anim+adur;adur=adur*9/10;if(adur<66)adur=66;}
  for(int k=0;k<NL;k++)want[k]=(k==apos)?1:0;
  if(anim==6599){adur=540;anext=6600;ablink=0;}
 }else if(anim<9600){                            /* 2.2-3.2 s all blinking: 180 ms, 20 % faster each flash, down to 30 ms */
  if(anim>=anext){ablink=!ablink;anext=anim+adur;adur=adur*80/100;if(adur<90)adur=90;}
  for(int k=0;k<NL;k++)want[k]=ablink;
 }else{for(int k=0;k<NL;k++)want[k]=0;}          /* 3.2-3.4 s dark, then the volume LED and normal operation */
 anim++;if(anim>=10200)anim=-1;
}
if(++refresh>=1500){refresh=0;sent[ri]=2;ri=(ri+1)%NL;} /* every 0.5 s one LED is re-sent: the panel recovers after a replug or power cycle */
for(int k=0;k<NL;k++)if(hold[k]>0)hold[k]--;
if(gap>0)gap--;
if(gap==0&&MidiGetOutputBufferAvailable(MIDI_DEVICE_USB_HOST)>=4){ /* at least 10 ms between any two LED messages: the iC may drop messages that arrive back to back */ /* nothing is queued while no device is attached */
 for(int j=0;j<NL;j++){int k=(rr+j)%NL;    /* round robin: a fast-blinking rate LED can't starve the others */
  if(want[k]!=sent[k]&&hold[k]==0){sendLed(k,want[k]);sent[k]=want[k];hold[k]=12;gap=(anim>=0)?12:30;rr=k+1;break;}  /* light show: 4 ms spacing so all five LEDs switch together */ /* one message per tick, at least 4 ms between changes of one LED */
 }
}
         ]]></code.krate>
      </object>
   </patchobj>
