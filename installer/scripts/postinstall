#!/bin/sh
# Twenty Engine installer: after the files are in place
# 1. remove older copies installed by hand in the user's own Library, so the host doesn't see two versions
USER_NAME=$(stat -f%Su /dev/console 2>/dev/null)
if [ -n "$USER_NAME" ] && [ "$USER_NAME" != "root" ]; then
  USER_HOME=$(dscl . -read "/Users/$USER_NAME" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
  if [ -n "$USER_HOME" ]; then
    rm -rf "$USER_HOME/Library/Audio/Plug-Ins/Components/TwentyEngine.component"
    rm -rf "$USER_HOME/Library/Audio/Plug-Ins/VST3/TwentyEngine.vst3"
    rm -rf "$USER_HOME/Library/Audio/Plug-Ins/Components/TwentyEngineAutomation.component"
    rm -rf "$USER_HOME/Library/Audio/Plug-Ins/VST3/TwentyEngineAutomation.vst3"
    rm -rf "$USER_HOME/Library/Audio/Plug-Ins/Components/TwentyEngineStudio.component"   # test builds, before the rename
    rm -rf "$USER_HOME/Library/Audio/Plug-Ins/VST3/TwentyEngineStudio.vst3"
    # Twenty Engine UI's sounds as preset files, for hosts that only list files (Ableton Live, Push).
    # Each one recalls a memory slot; the user's own preset files there are left alone.
    SRC="$(dirname "$0")/presets"
    DST="$USER_HOME/Library/Audio/Presets/Peter Kohlmetz Moller/Twenty Engine UI"
    if [ -d "$SRC" ]; then
      mkdir -p "$DST" && cp -f "$SRC"/*.aupreset "$DST"/ 2>/dev/null
      chown -R "$USER_NAME" "$USER_HOME/Library/Audio/Presets/Peter Kohlmetz Moller" 2>/dev/null
    fi
  fi
fi
rm -rf "/Library/Audio/Plug-Ins/Components/TwentyEngineStudio.component" "/Library/Audio/Plug-Ins/VST3/TwentyEngineStudio.vst3"
# 2. make sure nothing is flagged as "downloaded from the internet"
xattr -dr com.apple.quarantine "/Library/Audio/Plug-Ins/Components/TwentyEngine.component" 2>/dev/null
xattr -dr com.apple.quarantine "/Library/Audio/Plug-Ins/VST3/TwentyEngine.vst3" 2>/dev/null
xattr -dr com.apple.quarantine "/Library/Audio/Plug-Ins/Components/TwentyEngineAutomation.component" 2>/dev/null
xattr -dr com.apple.quarantine "/Library/Audio/Plug-Ins/VST3/TwentyEngineAutomation.vst3" 2>/dev/null
# 3. let macOS rescan Audio Units
killall -9 AudioComponentRegistrar 2>/dev/null
exit 0
